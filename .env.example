# Replace URL with your Saleor backend. Make sure to keep the slash at the end.
NEXT_PUBLIC_SALEOR_API_URL=https://storefront1.saleor.cloud/graphql/

# make sure to add it on production for correct canonical URLs
NEXT_PUBLIC_STOREFRONT_URL=http://localhost:3000

# Token used for fetching channels
SALEOR_APP_TOKEN=

# GA4 measurement ID for e-commerce funnel tracking (e.g. G-XXXXXXXXXX)
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# proton_analytics service (product view tracking + trending scores).
# SERVER-SIDE ONLY — must never be NEXT_PUBLIC_. The service has no auth and is
# internal-network only; the browser reaches it solely via /api/analytics/track-view.
# In Docker (shared network) this becomes: http://proton_analytics:4000
ANALYTICS_SERVICE_URL=http://localhost:4000

# Shared secret for verifying the Saleor ORDER_CREATED webhook's signature
# (HMAC-SHA256 over the raw request body, compared against the
# Saleor-Signature header — same verification pattern as proton-payments).
# Must match the secret_key set on the Webhook row in Saleor exactly.
# Generate with: openssl rand -hex 32
ORDER_WEBHOOK_SECRET=

# proton_identity service (phone number <-> Saleor user id lookup).
# SERVER-SIDE ONLY — must never be NEXT_PUBLIC_. PHONE_IDENTITY_SERVICE_TOKEN in
# particular must never reach the browser: it authorizes reading/writing every
# account's phone number. Both routes that call this service
# (src/app/api/identity/set-phone, src/app/api/identity/phone-status) run
# server-side only. In Docker (shared network) the URL becomes:
# http://proton_identity:5001
PHONE_IDENTITY_SERVICE_URL=http://localhost:5001
PHONE_IDENTITY_SERVICE_TOKEN=

# Feature flag: exposes phone/OTP login (the "Email or Phone Number" smart field's
# phone-detection path and its "Send code" flow) in LoginForm and the AuthModal.
# Off by default — proton_identity's SMS delivery is still a dev-stub with no real
# SMS provider wired in, so real customers currently receive no actual text message
# for a code. Safe to flip to "true" for local/dev testing; leave unset/false in
# production until a real SMS provider is wired in. Public on purpose — the client
# needs it to decide what to render.
NEXT_PUBLIC_PHONE_LOGIN_ENABLED=false

# Courier delivery worklist (/courier). Couriers are ordinary Saleor CUSTOMER
# accounts — never staff (see CLAUDE.md's courier section for why a staff-based
# design was rejected after a Phase 0 security audit found several Saleor
# 3.23.35 capabilities gated only by "is staff", no specific permission).
#
# COURIER_USER_IDS — comma-separated Saleor GLOBAL USER IDS (not emails — a
# courier's email can change, their account id can't) allowed onto the
# worklist. Unset or empty means nobody is a courier (fails closed). Find a
# customer's id in Dashboard → Customers → (the customer) → copy from the URL.
# Example: COURIER_USER_IDS=VXNlcjox,VXNlcjoy
COURIER_USER_IDS=

# SALEOR_COURIER_APP_TOKEN — token for a dedicated Saleor App ("Courier
# worklist") with ONLY the MANAGE_ORDERS permission. All order reads/writes on
# the courier worklist run server-side with this token; it never reaches the
# browser and a courier's own session never carries any Saleor permission.
SALEOR_COURIER_APP_TOKEN=
